---
import { Bibliography as SharedBibliography } from '@jjlmoya/utils-shared';
import { storageUnitSizeCalculator } from './entry';
import type { KnownLocale } from '../../types';

interface Props { locale?: KnownLocale; }
const { locale = 'en' } = Astro.props;
const content = await storageUnitSizeCalculator.i18n[locale]?.() ?? await storageUnitSizeCalculator.i18n.en!();
---
<SharedBibliography links={content.bibliography} />
