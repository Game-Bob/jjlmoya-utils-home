---
import { Bibliography as SharedBibliography } from '@jjlmoya/utils-shared';
import { solarBatteryAutonomyCalculator } from './index';
import type { KnownLocale } from '../../types';
interface Props { locale?: KnownLocale; }
const { locale = 'en' } = Astro.props;
const content = await solarBatteryAutonomyCalculator.i18n[locale]?.() ?? await solarBatteryAutonomyCalculator.i18n.en!();
---
<SharedBibliography links={content.bibliography} />
