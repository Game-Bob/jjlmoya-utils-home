---
import { Bibliography as SharedBibliography } from '@jjlmoya/utils-shared';
import { waterHeaterRecoveryTimeCalculator } from './index';
import type { KnownLocale } from '../../types';
interface Props { locale?: KnownLocale; }
const { locale = 'en' } = Astro.props;
const content = await waterHeaterRecoveryTimeCalculator.i18n[locale]?.() ?? await waterHeaterRecoveryTimeCalculator.i18n.en!();
---
<SharedBibliography links={content.bibliography} />
